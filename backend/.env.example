# Lumière Cinema API - Configurações de Ambiente

PROJECT_NAME="Lumière Cinema API"
VERSION="1.0.0"
API_V1_STR="/v1"

# Banco de dados: SQLite local por padrão; PostgreSQL com asyncpg em produção
# Exemplo PostgreSQL: postgresql+asyncpg://usuario:senha@host:5432/lumiere
DATABASE_URL="sqlite+aiosqlite:///./lumiere.db"

# Domínios liberados para CORS (separados por vírgula no padrão JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://lumiere.vercel.app"]

# TMDB API (The Movie Database) para enriquecimento de sinopses e cartazes
TMDB_API_KEY="seu_token_tmdb_aqui"

# Política de conformidade de direitos autorais ('conservative' ou 'permissive')
REGION_POLICY="conservative"
